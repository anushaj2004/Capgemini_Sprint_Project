<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Suite">
  <test thread-count="5" name="Cross Browser Test">
  <parameter name="browser" value="chrome"></parameter>
    <classes>
      <class name="ecom.SwagLabs_Login.TC_Login_Functional"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Negative"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Integration"/>
      <class name="ecom.SwagLabs_Login.TC_Login_Negative"/>
      <class name="ecom.SwagLabs_Cart.TC_Cart_Functional"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Functional"/>
      <class name="ecom.SwagLabs_Cart.TC_Cart_Integration"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_NegativeIntegration"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Smoke"/>
      <class name="ecom.SwagLabs_Cart.TC_Cart_Negative"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_System"/>
      <class name="ecom.SwagLabs_Login.TC_Login_Integration"/>
    </classes>
  </test>
  <test thread-count="5" name="Cross Browser Test">
  <parameter name="browser" value="firefox"></parameter>
    <classes>
      <class name="ecom.SwagLabs_Login.TC_Login_Functional"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Negative"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Integration"/>
      <class name="ecom.SwagLabs_Login.TC_Login_Negative"/>
      <class name="ecom.SwagLabs_Cart.TC_Cart_Functional"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Functional"/>
      <class name="ecom.SwagLabs_Cart.TC_Cart_Integration"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_NegativeIntegration"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_Smoke"/>
      <class name="ecom.SwagLabs_Cart.TC_Cart_Negative"/>
      <class name="ecom.SwagLabs_Checkout.TC_Checkout_System"/>
      <class name="ecom.SwagLabs_Login.TC_Login_Integration"/>
    </classes>
  </test>
   <!-- Cross Browser Test -->
</suite> <!-- Cross Browser Suite -->
